{
  "ReverseProxy": {
    "Routes": {
      "pacientes-route": {
        "ClusterId": "pacientes-cluster",
        "Match": {
          "Path": "/pacientes/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/pacientes/{**catch-all}" }
        ]
      },
      "historiales-route": {
        "ClusterId": "historiales-cluster",
        "Match": {
          "Path": "/historiales/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/historiales/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "pacientes-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "pacientes-api": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "historiales-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "historial-clinico-api": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
