@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..voYh6MkGWobH5cJ9nH-1zYqdDX_KNzVDTgAI5ifwWTw
@pacienteId = 1
@historialId = 1

### Obtener token JWT (servicio independiente OAuthJWT)
POST {{gateway}}/oauth/token
Content-Type: application/json

{
  "usuario": "clinica_usuario",
  "contrasena": "U9!nF4#xR7@kP2$m"
}

### Estado del gateway
GET {{gateway}}/health

### Crear paciente
POST {{gateway}}/pacientes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cedula": "1755844436",
  "nombre": "Jordy",
  "apellido": "Prado",
  "direccion": "Calle 10 # 20-30"
}

### Listar pacientes
GET {{gateway}}/pacientes
Authorization: Bearer {{token}}

### Buscar paciente por id
GET {{gateway}}/pacientes/{{pacienteId}}
Authorization: Bearer {{token}}

### Actualizar paciente
PUT {{gateway}}/pacientes/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cedula": "1000123456",
  "nombre": "Ana María",
  "apellido": "García",
  "direccion": "Carrera 5 # 11-22"
}

### Crear historial clínico
POST {{gateway}}/historiales
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "idPaciente": {{pacienteId}},
  "numHistoria": "HC-0001",
  "diagnostico": "Migraña",
  "tratamiento": "Control médico y analgésico"
}

### Listar historiales
GET {{gateway}}/historiales
Authorization: Bearer {{token}}

### Buscar historial por id
GET {{gateway}}/historiales/{{historialId}}
Authorization: Bearer {{token}}

### Actualizar historial
PUT {{gateway}}/historiales/{{historialId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "idPaciente": {{pacienteId}},
  "numHistoria": "HC-0001",
  "diagnostico": "Migraña controlada",
  "tratamiento": "Seguimiento en 30 días"
}

### Eliminar historial
DELETE {{gateway}}/historiales/{{historialId}}
Authorization: Bearer {{token}}

### Eliminar paciente
DELETE {{gateway}}/pacientes/{{pacienteId}}
Authorization: Bearer {{token}}
